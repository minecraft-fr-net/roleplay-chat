#!/usr/bin/env bash
# Usage: ./bin/release
# Script interactif de release : bump de version, CHANGELOG, tag et push.

set -euo pipefail

BOLD='\033[1m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# ── Version actuelle ────────────────────────────────────────────────────────

CURRENT_VERSION=$(grep '^mod_version=' gradle.properties | cut -d= -f2-)
BASE_VERSION="${CURRENT_VERSION%+*}"
MC_VERSION="${CURRENT_VERSION#*+}"

MAJOR=$(echo "$BASE_VERSION" | cut -d. -f1)
MINOR=$(echo "$BASE_VERSION" | cut -d. -f2)
PATCH=$(echo "$BASE_VERSION" | cut -d. -f3)

echo ""
echo -e "${BOLD}Version actuelle :${NC} ${YELLOW}${CURRENT_VERSION}${NC}  (Minecraft ${MC_VERSION})"
echo ""

# ── Choix du type de bump ───────────────────────────────────────────────────

echo "Quel type de release ?"
echo "  1) major  →  $((MAJOR + 1)).0.0+${MC_VERSION}"
echo "  2) minor  →  ${MAJOR}.$((MINOR + 1)).0+${MC_VERSION}"
echo "  3) patch  →  ${MAJOR}.${MINOR}.$((PATCH + 1))+${MC_VERSION}"
echo ""
read -rp "Choix [1/2/3] : " CHOICE

case "$CHOICE" in
  1) NEW_BASE="$((MAJOR + 1)).0.0" ;;
  2) NEW_BASE="${MAJOR}.$((MINOR + 1)).0" ;;
  3) NEW_BASE="${MAJOR}.${MINOR}.$((PATCH + 1))" ;;
  *) echo "Choix invalide." >&2; exit 1 ;;
esac

NEW_VERSION="${NEW_BASE}+${MC_VERSION}"
TAG="V${NEW_VERSION}"

echo ""
echo -e "Nouvelle version : ${GREEN}${NEW_VERSION}${NC}  (tag ${TAG})"
echo ""
read -rp "Confirmer ? [y/N] : " CONFIRM
[[ "$CONFIRM" =~ ^[yY]$ ]] || { echo "Annulé."; exit 0; }

# ── Commits depuis le dernier tag ───────────────────────────────────────────

LAST_TAG=$(git tag --sort=-v:refname | head -1)
if [[ -n "$LAST_TAG" ]]; then
  RANGE="${LAST_TAG}..HEAD"
  echo ""
  echo "Commits depuis ${LAST_TAG} :"
else
  RANGE=""
  echo ""
  echo "Aucun tag précédent — tous les commits seront inclus."
fi

# ── Génération du CHANGELOG ─────────────────────────────────────────────────

FEATURES=""
FIXES=""
DOCS=""
OTHERS=""

# Emojis internes exclus du CHANGELOG utilisateur
INTERNAL_PATTERN="✅|👷|🔖|🚚|🖼️|🔧"

while IFS= read -r subject; do
  # Filtre les commits internes
  if echo "$subject" | grep -qP "${INTERNAL_PATTERN}"; then
    continue
  fi
  # Retire le préfixe "feat:" / "fix:" éventuel après l'emoji
  entry=$(echo "$subject" | sed 's/^[^ ]* \(feat\|fix\|docs\|test\|chore\|refactor\): //')

  case "$subject" in
    *"✨"*) FEATURES+="- ${entry}"$'\n' ;;
    *"🐛"*) FIXES+="- ${entry}"$'\n' ;;
    *"📝"*) DOCS+="- ${entry}"$'\n' ;;
    *)       OTHERS+="- ${entry}"$'\n' ;;
  esac
done < <(git log ${RANGE:+"$RANGE"} --pretty=format:"%s" --reverse)

TODAY=$(date +%Y-%m-%d)

NEW_SECTION="## [${NEW_VERSION}] - ${TODAY}"

[[ -n "$FEATURES" ]] && NEW_SECTION+=$'\n\n### Nouveautés\n'"${FEATURES%$'\n'}"
[[ -n "$FIXES" ]]    && NEW_SECTION+=$'\n\n### Corrections\n'"${FIXES%$'\n'}"
[[ -n "$DOCS" ]]     && NEW_SECTION+=$'\n\n### Documentation\n'"${DOCS%$'\n'}"
[[ -n "$OTHERS" ]]   && NEW_SECTION+=$'\n\n### Divers\n'"${OTHERS%$'\n'}"

CHANGELOG="CHANGELOG.md"

if [[ -f "$CHANGELOG" ]]; then
  TMP=$(mktemp)
  # Insère la nouvelle section après la ligne d'en-tête (# Changelog)
  awk -v section="${NEW_SECTION}" '
    NR == 1 { print; print ""; print section; print ""; next }
    { print }
  ' "$CHANGELOG" > "$TMP"
  mv "$TMP" "$CHANGELOG"
else
  printf '# Changelog\n\n%s\n' "${NEW_SECTION}" > "$CHANGELOG"
fi

echo ""
echo "CHANGELOG.md mis à jour."

# ── Mise à jour de gradle.properties ────────────────────────────────────────

sed -i.bak "s|^mod_version=.*|mod_version=${NEW_VERSION}|" gradle.properties
rm -f gradle.properties.bak

# ── Commit, tag, push ────────────────────────────────────────────────────────

git add gradle.properties "$CHANGELOG"
git commit -m "🔖 Release ${NEW_VERSION}"
git tag "${TAG}"
git push
git push origin "${TAG}"

echo ""
echo -e "✅  ${GREEN}${TAG} publié — workflow publish déclenché.${NC}"
