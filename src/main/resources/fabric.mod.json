{
	"schemaVersion": 1,
	"id": "roleplay-chat",
	"version": "${version}",
	"name": "Roleplay chat",
	"description": "This mod allows players to communicate in a roleplay (RP) setting with different ranges for various types of messages.",
	"authors": [
		"cprodhomme"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/roleplay-chat",
		"sources": "https://github.com/minecraft-fr-net/roleplay-chat"
	},
	"license": "CC0-1.0",
	"icon": "assets/roleplay-chat/icon.png",
	"environment": "*",
	"accessWidener": "roleplay-chat.accesswidener",
	"entrypoints": {
		"main": [
			"net.minecraftfr.roleplaychat.RoleplayChat"
		],
		"client": [
			"net.minecraftfr.roleplaychat.RoleplayChatClient"
		],
		"fabric-gametest": [
			"net.minecraftfr.roleplaychat.test.MessageTypePrefixTest"
		],
		"fabric-client-gametest": [
			"net.minecraftfr.roleplaychat.test.client.ChatDisplayTest",
			"net.minecraftfr.roleplaychat.test.client.ChatRadiusDisplayTest",
			"net.minecraftfr.roleplaychat.test.client.RpNameDisplayTest",
			"net.minecraftfr.roleplaychat.test.client.NameplateDisplayTest",
			"net.minecraftfr.roleplaychat.test.client.NameplateOcclusionDisplayTest",
			"net.minecraftfr.roleplaychat.test.client.NameplateHeadgearDisplayTest",
			"net.minecraftfr.roleplaychat.test.client.RpNameInputScreenTest"
		]
	},
	"mixins": [
		"roleplay-chat.mixins.json",
		{
			"config": "roleplay-chat.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.13",
		"minecraft": "~1.21.6",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}
